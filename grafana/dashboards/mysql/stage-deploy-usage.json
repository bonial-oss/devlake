          "rawQuery": true,
          "rawSql": "-- Stage deploys per component, using the deployment name (cicd_deployments.name)\nSELECT\n  CASE WHEN cd.name = '' OR cd.name IS NULL THEN 'N/A' ELSE cd.name END AS component,\n  COUNT(DISTINCT cdc.cicd_deployment_id) AS deploys\nFROM cicd_deployment_commits cdc\nJOIN cicd_deployments cd ON cd.id = cdc.cicd_deployment_id\nLEFT JOIN project_mapping pm\n  ON cdc.cicd_scope_id = pm.row_id AND pm.`table` = 'cicd_scopes'\nWHERE cdc.environment = 'STAGING'\n  AND pm.project_name IN ($project)\n  AND $__timeFilter(cdc.finished_date)\nGROUP BY component\nORDER BY deploys DESC",
          "refId": "A",
