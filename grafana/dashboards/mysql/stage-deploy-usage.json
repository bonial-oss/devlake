          "rawSql": "-- Deploy-first: materialize the (small) STAGING set, then match PRs.\nWITH stage AS (\n  SELECT DISTINCT commit_sha, ref_name, TRIM(TRAILING '.git' FROM repo_url) AS repo_url\n  FROM cicd_deployment_commits WHERE environment = 'STAGING'\n),\nconnected AS (\n  SELECT pr.id FROM pull_requests pr JOIN stage s ON s.commit_sha = pr.merge_commit_sha\n  UNION\n  SELECT prc.pull_request_id FROM pull_request_commits prc JOIN stage s ON s.commit_sha = prc.commit_sha\n  UNION\n  SELECT pr.id FROM pull_requests pr JOIN repos r ON r.id = pr.base_repo_id\n    JOIN stage s ON s.ref_name = pr.head_ref AND s.repo_url = TRIM(TRAILING '.git' FROM r.url)\n)\nSELECT COUNT(DISTINCT pr.id) AS `PRs connected to stage`\nFROM pull_requests pr\nJOIN project_mapping pm ON pm.row_id = pr.base_repo_id AND pm.`table` = 'repos'\nJOIN connected c ON c.id = pr.id\nWHERE pm.project_name IN ($project)\n  AND $__timeFilter(pr.created_date)",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
