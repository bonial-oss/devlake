      "targets": [
        {
          "datasource": "mysql",
          "editorMode": "code",
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "-- Individual PRs that reached stage, with their stage-deploy activity. Deploy-first.\nWITH stage AS (\n  SELECT cicd_deployment_id, commit_sha, ref_name, finished_date,\n         TRIM(TRAILING '.git' FROM repo_url) AS repo_url\n  FROM cicd_deployment_commits WHERE environment = 'STAGING'\n),\npr_stage AS (\n  SELECT pr.id AS pr_id, s.cicd_deployment_id, s.finished_date\n  FROM pull_requests pr JOIN stage s ON s.commit_sha = pr.merge_commit_sha\n  UNION\n  SELECT prc.pull_request_id, s.cicd_deployment_id, s.finished_date\n  FROM pull_request_commits prc JOIN stage s ON s.commit_sha = prc.commit_sha\n  UNION\n  SELECT pr.id, s.cicd_deployment_id, s.finished_date\n  FROM pull_requests pr JOIN repos r ON r.id = pr.base_repo_id\n    JOIN stage s ON s.ref_name = pr.head_ref AND s.repo_url = TRIM(TRAILING '.git' FROM r.url)\n)\nSELECT\n  COALESCE(pm.project_name, 'Unmapped') AS team,\n  pr.pull_request_key AS pr,\n  pr.title AS title,\n  r.name AS repo,\n  pr.author_name AS author,\n  pr.head_ref AS branch,\n  DATE(pr.created_date) AS created,\n  COUNT(DISTINCT ps.cicd_deployment_id) AS stage_deploys,\n  DATE(MAX(ps.finished_date)) AS last_stage_deploy,\n  pr.url AS url\nFROM pull_requests pr\nJOIN repos r ON r.id = pr.base_repo_id\nJOIN project_mapping pm ON pm.row_id = pr.base_repo_id AND pm.`table` = 'repos'\nJOIN pr_stage ps ON ps.pr_id = pr.id\nWHERE pm.project_name IN ($project)\n  AND $__timeFilter(pr.created_date)\nGROUP BY team, pr, title, repo, author, branch, created, url\nORDER BY stage_deploys DESC, last_stage_deploy DESC",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Stage-deployed PRs (detail)",
      "type": "table"
    },
