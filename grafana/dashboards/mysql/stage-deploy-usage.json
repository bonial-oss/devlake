          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "-- DEBUG: PRs created in range, scoped by project(s), with a deployed_to_stage flag. Deploy-first.\nWITH stage AS (\n  SELECT DISTINCT commit_sha, ref_name, TRIM(TRAILING '.git' FROM repo_url) AS repo_url\n  FROM cicd_deployment_commits WHERE environment = 'STAGING'\n),\nconnected AS (\n  SELECT pr.id FROM pull_requests pr JOIN stage s ON s.commit_sha = pr.merge_commit_sha\n  UNION\n  SELECT prc.pull_request_id FROM pull_request_commits prc JOIN stage s ON s.commit_sha = prc.commit_sha\n  UNION\n  SELECT pr.id FROM pull_requests pr JOIN repos r ON r.id = pr.base_repo_id\n    JOIN stage s ON s.ref_name = pr.head_ref AND s.repo_url = TRIM(TRAILING '.git' FROM r.url)\n)\nSELECT\n  COALESCE((\n    SELECT MIN(pm.project_name) FROM project_mapping pm\n    WHERE pm.row_id = pr.base_repo_id AND pm.`table` = 'repos'\n  ), 'Unmapped') AS team,\n  pr.pull_request_key AS pr,\n  r.name AS repo,\n  pr.author_name AS author,\n  pr.head_ref AS branch,\n  DATE(pr.created_date) AS created,\n  pr.merge_commit_sha AS merge_commit,\n  CASE WHEN c.id IS NOT NULL THEN 'yes' ELSE 'no' END AS deployed_to_stage,\n  pr.url AS url\nFROM pull_requests pr\nJOIN repos r ON r.id = pr.base_repo_id\nLEFT JOIN connected c ON c.id = pr.id\nWHERE $__timeFilter(pr.created_date)\n  AND EXISTS (\n    SELECT 1 FROM project_mapping pm\n    WHERE pm.row_id = pr.base_repo_id AND pm.`table` = 'repos'\n      AND pm.project_name IN ($project)\n  )\nORDER BY created DESC",
          "refId": "A",
