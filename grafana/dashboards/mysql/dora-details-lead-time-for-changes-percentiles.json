          "format": "table",
          "rawQuery": true,
          "rawSql": "with _pr_stats as (\n  SELECT distinct\n    pr.id,\n    date_format(cdc.finished_date,'%y/%m') as month,\n    ppm.pr_cycle_time\n  FROM pull_requests pr\n    join project_pr_metrics ppm on ppm.id = pr.id\n    join project_mapping pm on pr.base_repo_id = pm.row_id and pm.`table` = 'repos'\n    join cicd_deployment_commits cdc on ppm.deployment_commit_id = cdc.id\n  WHERE pm.project_name in (${project})\n    and pr.merged_date is not null\n    and ppm.pr_cycle_time is not null\n    and (ppm.is_authored_by_bot is null or ppm.is_authored_by_bot in (${author_type}))\n    and $__timeFilter(cdc.finished_date)\n),\n_ranks as (\n  SELECT *, percent_rank() over(PARTITION BY month order by pr_cycle_time) as ranks\n  FROM _pr_stats\n),\n_clt as (\n  SELECT month, max(pr_cycle_time) as clt\n  FROM _ranks\n  WHERE ranks <= 0.75\n  GROUP BY month\n)\nSELECT\n  cm.month,\n  case when _clt.clt is null then 0 else _clt.clt/60 end as 'p75 Lead Time (h)'\nFROM calendar_months cm\n  LEFT JOIN _clt on cm.month = _clt.month\nWHERE month_timestamp between DATE(DATE_FORMAT($__timeFrom(), '%Y-%m-01')) AND DATE(DATE_FORMAT($__timeTo(), '%Y-%m-01'))\nORDER BY month_timestamp",
          "refId": "A"
        }
